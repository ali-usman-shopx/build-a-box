
<script
  src="{{ 'bundle-grid.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign bundle_width = section.settings.bundle_width
  assign column_gap = section.settings.column_gap

%}

{% comment %} if section.settings.background_color != blank
  render 'contrast-override',
    background_color: section.settings.background_color,
    section_id: section.id
endif {% endcomment %}
<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<bundle-grid
  class="bundle-grid section spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  data-section-id="{{ section.id }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --bundle-width: {{ bundle_width }}%;
    --bundle-grid-gap: {{ column_gap }}px;
  "
>
  <div class="bundle-grid__layout">
    {% content_for 'blocks' %}
  </div>
</bundle-grid>

{% stylesheet %}
  /* =========================================================
     1. SECTION ROOT
  ========================================================= */

  bundle-grid {
    display: block;
    position: relative;
    width: 100%;
  }

  /* =========================================================
     2. DESKTOP TWO-COLUMN LAYOUT
     Preserve the existing grid and column proportions.
  ========================================================= */

  .bundle-grid__layout {
    display: grid;
    grid-template-columns:
      minmax(0, var(--bundle-width))
      minmax(0, 1fr);
    gap: var(--bundle-grid-gap);
    align-items: stretch;
  }

  .bundle-grid__layout > * {
    min-width: 0;
  }

  /* =========================================================
     3. DESKTOP STICKY SUMMARY
  ========================================================= */

  .bundle-grid__bundle-container {
    position: sticky;
    top: 24px;
    align-self: start;
    min-width: 0;
  }

  /* =========================================================
     4. PRODUCT GRID COLUMN
  ========================================================= */

  .bundle-grid__grid-container {
    grid-column: 2;
    min-width: 0;
  }

  /* =========================================================
     5. COLLECTION SPACING AND HEADINGS
  ========================================================= */

  .bundle-grid__collection + .bundle-grid__collection {
    margin-block-start: 40px;
  }

  .bundle-grid__collection-heading {
    margin: 0 0 20px;
  }

  /* =========================================================
     6. PRODUCT GRID
  ========================================================= */

  .bundle-grid__product-grid {
    display: grid;
    grid-template-columns: repeat(
      var(--collection-grid-columns, 3),
      minmax(0, 1fr)
    );
    gap: var(--collection-grid-gap, 24px);
    align-items: start;
  }

  /* =========================================================
     7. PRODUCT MEDIA
  ========================================================= */

  .bundle-grid__product-media {
    width: 100%;
    overflow: hidden;
  }

  .bundle-grid__product-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* =========================================================
     8. PRODUCT DETAILS AND PRICES
  ========================================================= */

  .bundle-grid__product-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bundle-grid__product-title {
    margin: 0;
    font-size: inherit;
    font-weight: 500;
  }

  .bundle-grid__product-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }

  .bundle-grid__product-price s {
    opacity: 0.65;
  }

  /* =========================================================
     9. EMPTY COLLECTION STATE
  ========================================================= */

  .bundle-grid__empty-collection {
    margin: 0;
  }

  /* =========================================================
     10. MOBILE LAYOUT
     Reverse the visual order so the bundle is at the bottom
     and the product grid is above it.
  ========================================================= */

  @media screen and (max-width: 749px) {
    .bundle-grid__layout {
      display: flex;
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 0;
      padding-bottom: calc(150px + env(safe-area-inset-bottom));
    }

    .bundle-grid__layout > * {
      width: 100%;
      min-width: 0;
    }

    /*
      This higher-specificity rule overrides the desktop
      sticky positioning from the parent section.
    */
    .bundle-grid__layout > .bundle-grid__bundle-container {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      top: auto;
      align-self: auto;
    }

    .bundle-grid__grid-container {
      grid-column: auto;
      width: 100%;
    }

    .bundle-grid__product-grid {
      grid-template-columns: repeat(
        var(--collection-grid-columns-mobile, 2),
        minmax(0, 1fr)
      );
    }

    .bundle-grid__collection + .bundle-grid__collection {
      margin-block-start: 32px;
    }

    .bundle-grid__collection-heading {
      margin-block-end: 16px;
    }
  }

  /* =========================================================
     11. ACCESSIBILITY
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .bundle-grid__bundle-container {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle and grid",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_bundle-container"
    },
    {
      "type": "_grid-container"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "bundle_width",
      "label": "Bundle column width",
      "min": 20,
      "max": 45,
      "step": 1,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Bundle and grid",
      "category": "Products",
      "blocks": {
        "bundle": {
          "type": "_bundle-container"
        },
        "grid": {
          "type": "_grid-container"
        }
      },
      "block_order": ["bundle", "grid"]
    }
  ]
}
{% endschema %}
